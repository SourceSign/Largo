<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac-only entitlements beyond the sandbox settings in the build settings. -->
<plist version="1.0">
<dict>
	<!-- Bookmarks to the user's song files, so they can be reopened without copying them. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
